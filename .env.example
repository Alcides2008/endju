# Copiar para .env.local e preencher. Lista completa e explicação: docs/05-variaveis-de-ambiente.md
# Só as variáveis NEXT_PUBLIC_* chegam ao browser.

# ── Etapa 1 · Site e Firebase ──────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase (consola → Definições do projeto → As tuas apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin SDK (consola → Contas de serviço → Gerar chave privada). Nunca com prefixo NEXT_PUBLIC.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary: a linha "API environment variable" da consola, com a chave e o segredo preenchidos
CLOUDINARY_URL=

# ── Desenvolvimento local com emuladores (opcional) ────────────
# Com `npm run emulators` a correr, usar projectId "demo-endju" e qualquer API key:
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-endju
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-endju.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-endju
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ── Etapas seguintes (ver docs/05) ─────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="ENDJU BUSINESS <pedidos@endju.ao>"
EMAIL_REPLY_TO=
MCX_GATEWAY_URL=
MCX_GATEWAY_TOKEN=
MCX_WEBHOOK_SECRET=
PAYREF_API_URL=
PAYREF_API_KEY=
PAYREF_ENTITY_ID=
PAYREF_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
INVOICING_PROVIDER=none
INVOICING_API_URL=
INVOICING_API_KEY=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Só scripts locais ──────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=

# Pagamentos (Etapa 7): fornecedor de teste até haver contrato EMIS/agregador
PAYMENT_WEBHOOK_SECRET=
# "on" liga o fornecedor de pagamentos de teste (botão Simular) num ambiente publicado; nunca em produção
PAYMENT_TEST_MODE=
# Cron diário dos prazos (a Vercel envia-o no Authorization)
CRON_SECRET=
